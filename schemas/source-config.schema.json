{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/source-config.schema.json",
  "title": "Reader App Source Config",
  "description": "Declarative description of how to scrape one website. The app's generic engine reads this and implements the Source interface from it. No executable code — data only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "lang", "contentType", "baseUrl", "popular", "search", "details", "chapters", "content"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Schema version the engine validates against."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Globally unique source id, kebab-case, e.g. 'example-manga-en'."
    },
    "name": { "type": "string", "minLength": 1 },
    "lang": {
      "type": "string",
      "description": "BCP-47 language tag, e.g. 'en', 'ja', 'de'.",
      "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
    },
    "contentType": { "type": "string", "enum": ["image", "text"] },
    "baseUrl": { "type": "string", "format": "uri" },
    "version": { "type": "string", "description": "Source config version, e.g. '1.0.0'." },

    "request": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional default request behavior for every call.",
      "properties": {
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Static headers to send (e.g. Referer, User-Agent)."
        },
        "useWebView": {
          "type": "boolean",
          "default": false,
          "description": "If true, load pages in a hidden WebView so the site's JS runs before the engine reads the resolved HTML. Use only when needed — it's slower."
        }
      }
    },

    "popular": { "$ref": "#/$defs/listEndpoint" },
    "search": {
      "allOf": [
        { "$ref": "#/$defs/listEndpoint" },
        {
          "type": "object",
          "properties": {
            "urlTemplate": {
              "description": "Must include {query} (and may include {page}).",
              "type": "string"
            }
          },
          "required": ["urlTemplate"]
        }
      ]
    },

    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "$ref": "#/$defs/extractor" },
            "cover": { "$ref": "#/$defs/extractor" },
            "authors": { "$ref": "#/$defs/extractorList" },
            "description": { "$ref": "#/$defs/extractor" },
            "genres": { "$ref": "#/$defs/extractorList" },
            "status": { "$ref": "#/$defs/extractor" }
          },
          "required": ["title"]
        }
      }
    },

    "chapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listSelector", "item"],
      "properties": {
        "listSelector": {
          "type": "string",
          "description": "CSS selector matching each chapter row/link."
        },
        "item": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title"],
          "properties": {
            "id": { "$ref": "#/$defs/extractor" },
            "title": { "$ref": "#/$defs/extractor" },
            "number": { "$ref": "#/$defs/extractor" },
            "publishedAt": { "$ref": "#/$defs/extractor" }
          }
        }
      }
    },

    "content": {
      "type": "object",
      "additionalProperties": false,
      "description": "How to extract the readable content of one chapter.",
      "oneOf": [
        {
          "title": "Image content (manga/manhwa/webtoon)",
          "required": ["type", "pageImageSelector"],
          "properties": {
            "type": { "const": "image" },
            "pageImageSelector": {
              "type": "string",
              "description": "CSS selector for each page <img>."
            },
            "pageImageAttr": {
              "type": "string",
              "default": "src",
              "description": "Attribute holding the image URL (e.g. 'src', 'data-src')."
            }
          },
          "additionalProperties": false
        },
        {
          "title": "Text content (light novel)",
          "required": ["type", "bodySelector"],
          "properties": {
            "type": { "const": "text" },
            "bodySelector": {
              "type": "string",
              "description": "CSS selector for the chapter body container."
            },
            "removeSelectors": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Selectors to strip out (ads, nav, share buttons)."
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },

  "$defs": {
    "listEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["urlTemplate", "listSelector", "item"],
      "properties": {
        "urlTemplate": {
          "type": "string",
          "description": "URL with placeholders. {page} for pagination; search also uses {query}."
        },
        "listSelector": {
          "type": "string",
          "description": "CSS selector matching each result card."
        },
        "nextPageSelector": {
          "type": "string",
          "description": "Optional selector whose presence indicates another page exists."
        },
        "item": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title"],
          "properties": {
            "id": { "$ref": "#/$defs/extractor" },
            "title": { "$ref": "#/$defs/extractor" },
            "cover": { "$ref": "#/$defs/extractor" }
          }
        }
      }
    },

    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "description": "How to pull one value out of the matched element (or the page).",
      "properties": {
        "selector": {
          "type": "string",
          "description": "CSS selector relative to the current element. Omit to use the current element itself."
        },
        "attr": {
          "type": "string",
          "description": "Attribute to read (e.g. 'href', 'src', 'data-src'). Omit to read text content."
        },
        "regex": {
          "type": "string",
          "description": "Optional regex; first capture group becomes the value."
        },
        "resolveUrl": {
          "type": "boolean",
          "default": false,
          "description": "If true, resolve a relative URL against baseUrl."
        }
      }
    },

    "extractorList": {
      "allOf": [
        { "$ref": "#/$defs/extractor" },
        {
          "type": "object",
          "properties": {
            "separator": {
              "type": "string",
              "description": "If set, split the extracted text on this separator into a list."
            }
          }
        }
      ]
    }
  }
}
